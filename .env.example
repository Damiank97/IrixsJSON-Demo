# Alleen server-side instellen. Gebruik eigen keys met API-restricties.
# Groq blijft de bestaande demostandaard. 'disabled' schakelt externe AI uit.
IRIXS_AI_PROVIDER=groq
GROQ_API_KEY=
# Optioneel voor een andere OpenAI-compatible leverancier:
IRIXS_AI_BASE_URL=
IRIXS_AI_API_KEY=
IRIXS_AI_MODEL=
# Bonherkenning apart uitzetten of een geschikt visionmodel kiezen:
IRIXS_RECEIPT_AI_ENABLED=true
IRIXS_RECEIPT_AI_MODEL=

GOOGLE_MAPS_API_KEY=
TOMTOM_API_KEY=

AFAS_BASE_URL=
AFAS_TOKEN=
AFAS_PROJECTS_GETCONNECTOR=
AFAS_DECLARATION_TYPES_GETCONNECTOR=
AFAS_VALIDITY_GETCONNECTOR=

# Optionele veldmapping; dit zijn de standaard kolomnamen.
AFAS_PROJECT_CODE_FIELD=Project
AFAS_PROJECT_LABEL_FIELD=Omschrijving
AFAS_DECLARATION_TYPE_CODE_FIELD=Declaratiesoort
AFAS_DECLARATION_TYPE_LABEL_FIELD=Omschrijving
# Waarde per soort: kosten of kilometers.
AFAS_DECLARATION_KIND_FIELD=Invoertype

# Uitgewerkte combinaties: grondslagen/groepen/teams eerst oplossen in AFAS.
AFAS_VALIDITY_EMPLOYEE_FIELD=Medewerker
AFAS_VALIDITY_PROJECT_FIELD=Project
AFAS_VALIDITY_DECLARATION_TYPE_FIELD=Declaratiesoort
AFAS_VALIDITY_START_FIELD=Begindatum
AFAS_VALIDITY_END_FIELD=Einddatum
